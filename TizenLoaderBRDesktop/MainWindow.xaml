<Window x:Class="TizenLoaderBRDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TizenLoaderBRDesktop.Helpers"
        xmlns:models="clr-namespace:TizenLoaderBRDesktop.Models"
        Title="Tizen Loader BR Desktop"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:BoolToSimNaoConverter x:Key="BoolToSimNaoConverter" />
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tizen Loader BR Desktop" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Importação, análise e instalação de pacotes Tizen assinados via SDB para Samsung Galaxy Watch Tizen." Foreground="{StaticResource AppSubtleTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource AppSubtleTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="12">
            <TabItem Header="Dispositivos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Atualizar dispositivos" Command="{Binding RefreshDevicesCommand}" />
                            <Button Content="Verificar conexão" Command="{Binding TestConnectionCommand}" />
                            <Button Content="Listar apps instalados" Command="{Binding RefreshInstalledAppsCommand}" />
                        </WrapPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Relógios conectados">
                                <DataGrid ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="*" />
                                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="140" />
                                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Apps instalados no relógio">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <WrapPanel>
                                        <Button Content="Desinstalar selecionado" Command="{Binding UninstallSelectedAppCommand}" />
                                    </WrapPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding InstalledApps}"
                                              SelectedItem="{Binding SelectedInstalledApp, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Package ID" Binding="{Binding PackageId}" Width="*" />
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="120" />
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding PackageType}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Biblioteca">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Importar arquivo" Command="{Binding ImportPackageCommand}" />
                            <Button Content="Adicionar candidato" Command="{Binding ImportSelectedCandidateCommand}" />
                            <Button Content="Instalar no relógio" Command="{Binding InstallSelectedLibraryItemCommand}" />
                            <Button Content="Excluir da biblioteca" Command="{Binding DeleteSelectedLibraryItemCommand}" />
                            <ComboBox Width="180" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding SelectedLibraryFilter}" />
                        </WrapPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Itens da biblioteca">
                                <DataGrid ItemsSource="{Binding LibraryView}"
                                          SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Package.DisplayName}" Width="*" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Package.Kind}" Width="90" />
                                        <DataGridTextColumn Header="Package ID" Binding="{Binding Analysis.PackageId}" Width="*" />
                                        <DataGridTextColumn Header="Versão" Binding="{Binding Analysis.Version}" Width="110" />
                                        <DataGridTextColumn Header="Assinada" Binding="{Binding Analysis.SignatureFound, Converter={StaticResource BoolToSimNaoConverter}}" Width="90" />
                                        <DataGridTextColumn Header="Instalável" Binding="{Binding Analysis.ProbablyInstallable, Converter={StaticResource BoolToSimNaoConverter}}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Detalhes da análise">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedLibraryItem.Package.FileName, TargetNullValue=Selecione um item da biblioteca}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.Sha256, TargetNullValue=SHA-256 aparecerá aqui}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.PackageId, StringFormat=Package ID: {0}, TargetNullValue=Package ID: -}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.AppId, StringFormat=App ID: {0}, TargetNullValue=App ID: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.Name, StringFormat=Nome: {0}, TargetNullValue=Nome: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.Version, StringFormat=Versão: {0}, TargetNullValue=Versão: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.DetectedType, StringFormat=Tipo detectado: {0}, TargetNullValue=Tipo detectado: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.SignatureFound, StringFormat=Assinatura detectada: {0}, TargetNullValue=Assinatura detectada: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.UsesInternet, StringFormat=Usa internet: {0}, TargetNullValue=Usa internet: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.IsWatchfaceCandidate, StringFormat=Candidato a watchface: {0}, TargetNullValue=Candidato a watchface: -}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.IsShellCandidate, StringFormat=Candidato a casca: {0}, TargetNullValue=Candidato a casca: -}" Margin="0,4,0,0" />

                                        <TextBlock Text="Permissões" FontWeight="SemiBold" Margin="0,14,0,4" />
                                        <ItemsControl ItemsSource="{Binding SelectedLibraryItem.Analysis.Permissions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Palavras úteis encontradas" FontWeight="SemiBold" Margin="0,14,0,4" />
                                        <ItemsControl ItemsSource="{Binding SelectedLibraryItem.Analysis.KeywordsFound}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Avisos" FontWeight="SemiBold" Margin="0,14,0,4" />
                                        <ItemsControl ItemsSource="{Binding SelectedLibraryItem.Analysis.Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>

                        <GroupBox Grid.Row="2" Header="Candidatos encontrados em ZIP">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding ImportCandidates}"
                                          SelectedItem="{Binding SelectedImportCandidate, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="*" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="90" />
                                        <DataGridTextColumn Header="Origem" Binding="{Binding OriginalContainerPath}" Width="2*" />
                                        <DataGridTextColumn Header="Arquivo interno" Binding="{Binding IsFromArchive, Converter={StaticResource BoolToSimNaoConverter}}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1" Text="Se um ZIP contiver vários pacotes, escolha um item acima e clique em 'Adicionar candidato'." Foreground="{StaticResource AppSubtleTextBrush}" Margin="4,8,4,0" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Fontes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Fontes comunitárias">
                            <StackPanel>
                                <TextBlock Text="O app não faz scraping automático do XDA. Você pode abrir o fórum no navegador e também colar um link direto para baixar um pacote .wgt, .tpk ou .zip." TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Abrir XDA no navegador" Command="{Binding OpenXdaCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Baixar por URL direta">
                            <StackPanel>
                                <TextBlock Text="Cole um link direto para um arquivo Tizen e use o botão de download. Se vier um ZIP, o app vai procurar .wgt e .tpk internos." TextWrapping="Wrap" />
                                <DockPanel Margin="0,10,0,0">
                                    <Button Content="Baixar e importar" Command="{Binding DownloadFromUrlCommand}" DockPanel.Dock="Right" />
                                    <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}" MinWidth="450" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnóstico">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel>
                            <Button Content="Copiar logs" Command="{Binding CopyLogsCommand}" />
                            <Button Content="Limpar logs" Command="{Binding ClearLogsCommand}" />
                            <Button Content="Salvar logs" Command="{Binding SaveLogsCommand}" />
                        </WrapPanel>

                        <GroupBox Grid.Row="1" Header="Comandos úteis">
                            <TextBlock Text="{Binding UsefulCommandsText}" FontFamily="Consolas" TextWrapping="Wrap" />
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Log de conexão, importação, análise, instalação e desinstalação">
                            <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp}" Width="160" />
                                    <DataGridTextColumn Header="Nível" Binding="{Binding Level}" Width="80" />
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="140" />
                                    <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Configurações">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Caminhos do aplicativo">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="sdb.exe" VerticalAlignment="Center" Margin="4" />
                                <TextBox Grid.Column="1" Text="{Binding SdbPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Detectar" Command="{Binding DetectSdbCommand}" />

                                <TextBlock Grid.Row="1" Text="Pasta de trabalho" VerticalAlignment="Center" Margin="4" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="" />

                                <TextBlock Grid.Row="2" Text="Pasta de download" VerticalAlignment="Center" Margin="4" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="" />
                            </Grid>
                        </GroupBox>

                        <WrapPanel>
                            <Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}" />
                            <Button Content="Atualizar biblioteca" Command="{Binding ReloadLibraryCommand}" />
                            <Button Content="Atualizar dispositivos" Command="{Binding RefreshDevicesCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
