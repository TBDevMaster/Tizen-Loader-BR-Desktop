<Window x:Class="TizenLoaderBRDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TizenLoaderBRDesktop.Helpers"
        Title="Tizen Loader BR Desktop"
        Width="820"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        Icon="Assets/Images/app-icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:BoolToSimNaoConverter x:Key="BoolToSimNaoConverter" />
        <helpers:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="StatusTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppPanelDarkBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             From="1" To="1.03" Duration="0:0:1.5" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             From="1" To="1.03" Duration="0:0:1.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{StaticResource AppPanelDarkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppAccentBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppAccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppAccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Images/app-logo-transparent.png"
                               Width="34"
                               Height="34"
                               Stretch="Uniform"
                               Margin="0,0,8,0" />
                        <TextBlock Text="Tizen Loader BR Desktop"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Importação, análise e instalação de pacotes Tizen assinados via SDB para Samsung Galaxy Watch Tizen."
                               Foreground="{StaticResource AppSubtleTextBrush}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource AppSubtleTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Navegação" FontSize="14" FontWeight="SemiBold" Margin="4,0,4,10" />
                    <ListBox SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem Content="Dispositivos" />
                        <ListBoxItem Content="Biblioteca" />
                        <ListBoxItem Content="Fontes" />
                        <ListBoxItem Content="Diagnóstico" />
                        <ListBoxItem Content="Configurações" />
                        <ListBoxItem Content="Créditos" />
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                    <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.5*" />
                                <RowDefinition Height="0.7*" />
                                <RowDefinition Height="0.8*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Atualizar" Command="{Binding RefreshDevicesCommand}" />
                                <Button Content="Conexao" Command="{Binding TestConnectionCommand}" />
                                <Button Content="Buscar rede" Command="{Binding ScanNetworkCommand}" />
                            </WrapPanel>

                            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                <Button Content="Conectar IP" Command="{Binding ConnectByAddressCommand}" DockPanel.Dock="Right" />
                                <TextBox Text="{Binding ConnectAddress, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="180"
                                         ToolTip="IP do relogio. Se nao informar porta, usa 26101." />
                            </DockPanel>

                            <GroupBox Grid.Row="2" Header="Relogios conectados">
                                <DataGrid ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IP" Binding="{Binding DisplayAddress}" Width="180" />
                                        <DataGridTextColumn Header="Conexao" Binding="{Binding ConnectionStatus}" Width="120" />
                                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Row="3" Header="Apps instalados no relogio">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <WrapPanel>
                                        <Button Content="Listar apps" Command="{Binding RefreshInstalledAppsCommand}" />
                                        <Button Content="Desinstalar" Command="{Binding UninstallSelectedAppCommand}" />
                                    </WrapPanel>

                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding InstalledApps}"
                                              SelectedItem="{Binding SelectedInstalledApp, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>                                        <DataGridTemplateColumn Header="" Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Width="24"
                                                           Height="24"
                                                           Source="{Binding IconSource}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>                                            <DataGridTextColumn Header="Package ID" Binding="{Binding PackageId}" Width="240" />
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Versao" Binding="{Binding Version}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="4" Header="Log de desinstalacao">
                                <TextBox Text="{Binding UninstallLogText}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </GroupBox>

                            <GroupBox Grid.Row="5" Header="Status do relogio">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Content="Atualizar status"
                                            Command="{Binding RefreshDeviceStatusCommand}"
                                            HorizontalAlignment="Left" />

                                    <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                                        <Border Style="{StaticResource StatusTileStyle}" Width="170">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="18" Margin="0,0,6,0" />
                                                    <TextBlock Text="Bateria" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" />
                                                </StackPanel>
                                                <ProgressBar Value="{Binding DeviceStatus.BatteryPercent}" Maximum="100" Height="18" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding DeviceStatus.BatteryText}" Foreground="{StaticResource AppSubtleTextBrush}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatusTileStyle}" Width="170">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🧠" FontSize="18" Margin="0,0,6,0" />
                                                    <TextBlock Text="Memória" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" />
                                                </StackPanel>
                                                <ProgressBar Value="{Binding DeviceStatus.MemoryUsagePercent}" Maximum="100" Height="18" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding DeviceStatus.MemoryText}" Foreground="{StaticResource AppSubtleTextBrush}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatusTileStyle}" Width="170">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="💾" FontSize="18" Margin="0,0,6,0" />
                                                    <TextBlock Text="Disco" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" />
                                                </StackPanel>
                                                <ProgressBar Value="{Binding DeviceStatus.RootDiskPercent}" Maximum="100" Height="18" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding DeviceStatus.RootDiskText}" Foreground="{StaticResource AppSubtleTextBrush}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatusTileStyle}" Width="170">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⏱" FontSize="18" Margin="0,0,6,0" />
                                                    <TextBlock Text="Uptime" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeviceStatus.UptimeText}" Foreground="{StaticResource AppSubtleTextBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <TextBox Grid.Row="2"
                                             Text="{Binding DeviceStatusText}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                                </Grid>
                            </GroupBox>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                    <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.5*" />
                                <RowDefinition Height="1.1*" />
                                <RowDefinition Height="0.7*" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Content="Atualizar" Command="{Binding RefreshLibraryFromFolderCommand}" />
                                    <Button Content="Instalar" Command="{Binding InstallSelectedLibraryItemCommand}" />
                                    <Button Content="Excluir" Command="{Binding DeleteSelectedLibraryItemCommand}" />
                                </StackPanel>
                                <ComboBox Width="140"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding LibraryFilters}"
                                          SelectedItem="{Binding SelectedLibraryFilter}" />
                            </DockPanel>

                            <GroupBox Grid.Row="1" Header="Itens da biblioteca">
                                <DataGrid ItemsSource="{Binding LibraryView}"
                                          SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Package.DisplayName}" Width="*" />
                                        <DataGridTextColumn Header="Package ID" Binding="{Binding Analysis.PackageId}" Width="240" />
                                        <DataGridTextColumn Header="Versao" Binding="{Binding Analysis.Version}" Width="80" />
                                        <DataGridTextColumn Header="Assinada" Binding="{Binding Analysis.SignatureFound, Converter={StaticResource BoolToSimNaoConverter}}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Row="2" Header="Detalhes da analise">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Visibility="{Binding SelectedLibraryItem, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedLibraryItem.Package.FileName, TargetNullValue=Selecione um item da biblioteca}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.Sha256, TargetNullValue=SHA-256 aparecerá aqui}"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.PackageId, StringFormat=Package ID: {0}, TargetNullValue=Package ID: -}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.Name, StringFormat=Nome: {0}, TargetNullValue=Nome: -}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.Version, StringFormat=Versão: {0}, TargetNullValue=Versão: -}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.DetectedType, StringFormat=Tipo detectado: {0}, TargetNullValue=Tipo detectado: -}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.SignatureFound, StringFormat=Assinatura detectada: {0}, TargetNullValue=Assinatura detectada: -}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedLibraryItem.Analysis.IsWatchfaceCandidate, StringFormat=Candidato a watchface: {0}, TargetNullValue=Candidato a watchface: -}" Margin="0,2,0,0" />
                                        <TextBlock Text="Avisos" FontWeight="SemiBold" Margin="0,10,0,4" />
                                        <ItemsControl ItemsSource="{Binding SelectedLibraryItem.Analysis.Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>

                            <GroupBox Grid.Row="3" Header="Log de instalacao">
                                <Grid>
                                    <TextBox Text="{Binding InstallLogText}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto" />
                                </Grid>
                            </GroupBox>

                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <GroupBox Header="Fontes comunitárias">
                                <StackPanel>
                                    <TextBlock Text="O app nao faz scraping automatico do XDA. Abra a fonte comunitaria no navegador e baixe os pacotes manualmente para a pasta configurada."
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Abrir XDA" Command="{Binding OpenXdaCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                    <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel>
                                <Button Content="Copiar" Command="{Binding CopyLogsCommand}" />
                                <Button Content="Limpar" Command="{Binding ClearLogsCommand}" />
                                <Button Content="Salvar" Command="{Binding SaveLogsCommand}" />
                            </WrapPanel>

                            <GroupBox Grid.Row="1" Header="Comandos úteis">
                                <TextBlock Text="{Binding UsefulCommandsText}" FontFamily="Consolas" TextWrapping="Wrap" />
                            </GroupBox>

                            <GroupBox Grid.Row="2" Header="Log de conexão, importação, análise, instalação e desinstalação">
                                <DataGrid ItemsSource="{Binding Logs}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp}" Width="150" />
                                        <DataGridTextColumn Header="Nível" Binding="{Binding Level}" Width="60" />
                                        <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="100" />
                                        <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <GroupBox Header="Caminhos do aplicativo">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Pasta de downloads" VerticalAlignment="Center" Margin="4" />
                                    <TextBox Grid.Column="1" Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="Selecionar pasta" Command="{Binding SelectDownloadFolderCommand}" />
                                </Grid>
                            </GroupBox>

                            <WrapPanel>
                                <Button Content="Salvar" Command="{Binding SaveSettingsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=5}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" HorizontalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="Tizen Loader BR Desktop"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4" />

                            <TextBlock Text="Desenvolvido por TB DEV para a comunidade Tizen BR. Obrigado por apoiar e testar o projeto."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource AppSubtleTextBrush}"
                                       Margin="0,0,0,12" />

                            <GroupBox Header="Doacao via Pix">
                                <StackPanel>
                                    <TextBlock Text="Chave Pix" FontWeight="SemiBold" />
                                    <TextBox Text="83850182-8a58-41b5-9603-3dfe1180205b"
                                             IsReadOnly="True"
                                             Margin="0,4,0,10" />
                                    <Image Source="/Assets/Images/pix-qr-code.png"
                                           MaxWidth="220"
                                           MaxHeight="220"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
